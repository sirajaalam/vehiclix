# =============================================================================
# VehiClix Master .gitignore (Root-level for Frontend & Backend)
# =============================================================================

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment & Secrets (Keep .env.example templates)
.env
.env.*
.env.local
!.env.example

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build Outputs & Caches
dist/
.next/
out/
build/
.vercel
*.tsbuildinfo
next-env.d.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Supabase Local CLI State
supabase/.temp/
supabase/.branches/
*/supabase/.temp/
*/supabase/.branches/

# Automated Tests & Coverage
test/
tests/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/

# AI Instructions & Prompt Files
Ai_Instructions/
AGENTS.md
CLAUDE.md
*/AGENTS.md
*/CLAUDE.md
